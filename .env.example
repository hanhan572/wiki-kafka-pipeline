# Copy to .env (never commit .env). Every value has a working default for local Docker use.

# --- Wikimedia asks API clients to identify themselves: put a contact address or repo URL here ---
WIKI_USER_AGENT=wiki-kafka-pipeline/1.0 (student project; contact: you@example.com)

# --- Postgres (docker-compose reads these) ---
POSTGRES_USER=wiki
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wiki

# --- Optional tuning ---
# WIKI_DOMAIN_SUFFIX=wikipedia.org     # which wikis the producer forwards ("" = all Wikimedia projects)
# RETENTION_HOURS=6                    # raw events older than this are pruned from Postgres
# Z_THRESHOLD=4.0                      # anomaly detector sensitivity

# --- Only when the dashboard / services run OUTSIDE docker-compose (e.g. Streamlit Cloud + hosted Postgres) ---
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# --- Only when using a hosted Kafka (Confluent Cloud, Redpanda Cloud, ...) ---
# KAFKA_BOOTSTRAP=pkc-xxxx.confluent.cloud:9092
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=PLAIN
# KAFKA_USERNAME=...
# KAFKA_PASSWORD=...
